<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布配置（Windows x64）
  - 命令行：dotnet publish src\ClassRTTranslator.App\ClassRTTranslator.App.csproj -c Release -p:PublishProfile=Win-x64-SingleFile
  - VS 2022：右键 ClassRTTranslator.App → 发布 → 选择本配置文件
  - 一键打包：仓库根目录运行 .\build-release.ps1
  产物输出：dist\publish\（脚本会进一步拷贝到 dist\ClassRTTranslator-Windows-x64\ 并压缩）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 目标运行时 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 自包含：无需目标机安装 .NET 运行时 -->
    <SelfContained>true</SelfContained>
    <!-- 单文件：所有程序集与依赖打包进一个 exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 不剪裁：避免 WPF/反射（NAudio、WinRT）在剪裁下出问题 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- native 库与 IL 打包进 exe，首次运行自动解压 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 单文件内压缩，减小体积 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 不发布调试符号，产物干净 -->
    <DebugType>none</DebugType>
    <!-- 发布目录：仓库根 dist\publish（相对本项目文件） -->
    <PublishDir>..\..\..\dist\publish\</PublishDir>
  </PropertyGroup>
</Project>
